# Copy to .env and set real values. The app refuses to start without them.
# Generate a key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-64-hex-chars  # gitleaks:allow (placeholder, not a credential)
TOKEN_TTL_MINUTES=60

# Docker Compose only: the PostgreSQL password, injected into both the database
# container and the app's connection URL. Unused by the plain SQLite quick start.
POSTGRES_PASSWORD=replace-with-a-long-random-value  # gitleaks:allow (placeholder, not a credential)

# One shared password for the three seeded demo accounts. The seed script
# refuses to run without it; no password is written in the repository.
DEMO_PASSWORD=replace-with-a-demo-password  # gitleaks:allow (placeholder, not a credential)
